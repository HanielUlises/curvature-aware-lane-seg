# --- Datasets & derived data (never commit; multi-GB, reproducible via scripts) ---
# Leading slash anchors this to the repo root. Without it the pattern also matched
# src/data/, which silently excluded the entire data-pipeline package from git.
/data/
*.zip
*.tar
*.tar.gz
*.tar.gz.part*
*.partial

# CurveLanes / CULane raw + intermediate artifacts
manifest*.json
*.lines.json.cache

# --- Model artifacts ---
checkpoints/
*.ckpt
*.pt
*.pth
*.onnx
lightning_logs/
wandb/
mlruns/

# --- Hydra / experiment outputs ---
outputs/
multirun/
.hydra/

# --- Visual verification dumps ---
viz/
*_overlay.png
samples/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.installed.cfg

# --- Virtual environments ---
.venv/
venv/
env/
.python-version

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- C++ deploy build artifacts (deploy/ is the Python-only exception) ---
deploy/build/
*.o
*.a

# --- Editor / OS ---
.vscode/
.idea/
*.swp
.DS_Store

# --- Secrets (Kaggle token etc. — never commit) ---
kaggle.json
.env
# Lossless frame dumps from scripts.viz_control (build artifact for GIF creation)
results/**/frames/

# Staged ONNX Runtime: symlinks into the installed wheel, machine-specific.
deploy/third_party/
